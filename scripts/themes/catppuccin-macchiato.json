    "$schema":  "https://raw.githubusercontent.com/earendil-works/envlinks/main/scripts/schemas/themepack-v1.schema.json",
    "name":  "catppuccin-macchiato",
    "description":  "Catppuccin Macchiato (soothing pastel dark theme) via the official nvim plugin",
    "author":  "Catppuccin",
    "source":  "https://github.com/catppuccin/nvim",
    "palette":  {
                    "base00":  "#24273a",
                    "base01":  "#1e2030",
                    "base02":  "#363a4f",
                    "base03":  "#494d64",
                    "base04":  "#5b6078",
