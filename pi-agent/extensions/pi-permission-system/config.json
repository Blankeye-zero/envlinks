{
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.*.env": "deny",
      "*.env.example": "allow",
      "*node_modules": {
        "action": "deny",
        "reason": "node_modules is installed dependency output, not project source"
      },
      "*node_modules/*": {
        "action": "deny",
        "reason": "node_modules is installed dependency output, not project source"
      }
    },
    "bash": {
      "*": "ask",
      "rm -rf *": "deny",
      "sudo *": "ask"
    },
    "external_directory": "ask",
    "powershell": {
      "*": "allow",
      "Remove-Item *-Recurse*-Force*": "ask",
      "rm *-rfo*": "ask",
      "del *": "ask",
      "format *": "deny"
    }
  },
  "yoloMode": true
}
