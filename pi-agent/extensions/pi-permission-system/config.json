{
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.*.env": "deny",
      "*.env.example": "allow"
    },
    "bash": {
      "*": "ask",
      "rm -rf *": "deny",
      "sudo *": "ask"
    },
    "external_directory": "ask",
    "powershell": {
      "*": "allow",
      "Remove-Item *-Recurse*-Force*": "ask",
      "rm *-rfo*": "ask",
      "del *": "ask",
      "format *": "deny"
    }
  },
  "yoloMode": false
}
