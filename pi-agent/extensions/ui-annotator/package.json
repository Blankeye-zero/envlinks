{
  "name": "pi-extension-ui-annotator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Run an Angular frontend and annotate UI elements in a live browser as context for pi",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "dependencies": {
    "puppeteer-core": "^23.10.4"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "scripts": {
    "test": "npm run build",
    "build": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node18 --alias:ws=./src/ws-shim.ts --outfile=dist/index.cjs"
  }
}
